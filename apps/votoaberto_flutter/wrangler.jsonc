{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "votoaberto-web",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./build/web",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
